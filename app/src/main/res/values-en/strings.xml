    <!-- Privacy page -->
    <string name="privacy_section_data">Data Storage</string>
    <string name="privacy_data_body">This app is a local-first, offline ebook reader. Your book files, reading progress, bookmarks, and highlight notes are all stored in a local database on your device. Nothing is uploaded to any server, and no account is required.</string>
    <string name="privacy_section_network">Network Permission</string>
    <string name="privacy_network_body">This app does not request the INTERNET permission. Core reading features (opening books, turning pages, searching, annotating, importing) work fully offline. External links inside books are handed to the system browser; the app itself makes no network requests.</string>
    <string name="privacy_section_crash">Crash Log</string>
    <string name="privacy_crash_body">Crash logging is off by default. When enabled, the app writes anonymized error info to a local file on unexpected exits — no book content, excerpts, or full file paths, and nothing is uploaded. You can manually share the crash log from Settings at any time, or turn this feature off.</string>
    <string name="privacy_section_deps">Third-Party Dependencies</string>
    <string name="privacy_deps_body">This app uses open-source libraries including Readium and Jetpack Compose. See the "Open Source Licenses" page for the full dependency list and licenses.</string>
